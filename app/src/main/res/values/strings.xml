    <string name="auto_switch_title">Seamless Hardware Switching (Optional)</string>
    <string name="auto_switch_description">AltShift can switch keyboards for you the moment your keyboard connects or disconnects.</string>
    <string name="auto_switch_status_active">Active</string>
    <string name="auto_switch_status_permission">Permission required</string>
    <string name="auto_switch_status_off">Off</string>
    <string name="auto_switch_hint_show">Learn how</string>
    <string name="auto_switch_hint_hide">Hide instructions</string>
    <string name="auto_switch_hint_description">Want AltShift to turn on automatically the instant you connect your keyboard? Android protects system keyboard settings for security, so this feature requires a one-time permission granted from a computer via USB.</string>
    <string name="adb_step_one_title">Step 1 · Connect to a computer</string>
    <string name="adb_step_one_body">Connect your device to a PC or Mac with a USB cable.</string>
    <string name="adb_step_two_title">Step 2 · Enable USB debugging</string>
    <string name="adb_step_two_body">Turn on USB debugging in Developer Options.</string>
    <string name="adb_developer_options_action">Developer Options</string>
    <string name="adb_step_three_title">Step 3 · Run the command</string>
    <string name="adb_step_three_body">Run this command in your computer\'s terminal:</string>
    <string name="adb_copy_command_action">Copy Command</string>
    <string name="adb_no_computer_notice">No computer? No problem! Without this permission, AltShift works normally and will simply show a convenient tap-to-switch bubble when your keyboard connects.</string>
    <string name="auto_switch_command">adb shell pm grant ru.b1sted.altshift android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="auto_switch_command_label">AltShift ADB command</string>
    <string name="auto_switch_permission_required">Grant WRITE_SECURE_SETTINGS over ADB to enable auto-switching.</string>
    <string name="command_copied">Command copied to clipboard.</string>


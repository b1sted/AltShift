    <string name="onboarding_step_enable_title">Enable AltShift</string>
    <string name="onboarding_step_enable_description">Turn on the AltShift keyboard in system settings so Android can use it. Keep an on-screen keyboard enabled too, so you can always type without a physical keyboard.</string>

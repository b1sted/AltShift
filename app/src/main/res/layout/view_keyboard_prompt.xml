<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/prompt_outer_horizontal_padding"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/prompt_outer_horizontal_padding"
    android:paddingBottom="28dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/promptCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/prompt_min_width"
        app:cardBackgroundColor="@color/prompt_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/prompt_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/prompt_card_padding_start"
            android:paddingTop="@dimen/prompt_card_padding_vertical"
            android:paddingEnd="@dimen/prompt_card_padding_end"
            android:paddingBottom="@dimen/prompt_card_padding_vertical">

            <ImageView
                android:id="@+id/promptIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification_keyboard"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Allow two lines on a 360dp phone instead of an ellipsis. The
                 weighted width lets the label absorb the space that remains
                 after the pinned action and close buttons. -->
            <TextView
                android:id="@+id/promptText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/prompt_icon_text_gap"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/prompt_keyboard_reconnected"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/promptAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/prompt_action_gap"
                android:background="@drawable/bg_prompt_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="40dp"
                android:paddingStart="@dimen/prompt_action_horizontal_padding"
                android:paddingEnd="@dimen/prompt_action_horizontal_padding"
                android:text="@string/notification_switch_back"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/promptClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/prompt_close_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/prompt_dismiss"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

    <string name="onboarding_step_enable_title">Включите AltShift</string>
    <string name="onboarding_step_enable_description">Включите клавиатуру AltShift в настройках системы, чтобы Android мог её использовать. Оставьте включённой и экранную клавиатуру — так вы всегда сможете печатать без физической.</string>
    <string name="onboarding_step_enable_action">ВКЛЮЧИТЬ В НАСТРОЙКАХ</string>
    <string name="onboarding_enable_soft_keyboard_action">ВКЛЮЧИТЬ ЭКРАННУЮ КЛАВИАТУРУ</string>
    <string name="onboarding_step_enable_status_ok">AltShift включён.</string>
    <string name="onboarding_step_enable_status_pending">AltShift ещё не включён.</string>
    <string name="onboarding_step_enable_status_no_soft_keyboard">Другие клавиатуры не включены. Включите экранную клавиатуру, чтобы не остаться без ввода.</string>

    <string name="onboarding_step_select_title">Выберите AltShift</string>
    <string name="onboarding_step_select_description">Выберите AltShift в качестве активного способа ввода для физической клавиатуры.</string>
    <string name="onboarding_step_select_action">ВЫБРАТЬ ALTSHIFT</string>
    <string name="onboarding_step_select_status_ok">AltShift — активная клавиатура.</string>
    <string name="onboarding_step_select_status_pending">AltShift включён, но не выбран.</string>
    <string name="onboarding_step_select_status_blocked">Сначала включите AltShift на шаге 1.</string>
    <string name="onboarding_step_select_status_no_soft_keyboard">Сначала включите экранную клавиатуру, чтобы печатать без физической.</string>

    <string name="onboarding_step_permissions_title">Разрешения</string>
    <string name="onboarding_step_permissions_description">Разрешите наложение поверх окон, уведомления и работу в фоне, чтобы AltShift мог переключать клавиатуры и запускать приложения по горячим клавишам.</string>
    <string name="onboarding_step_permissions_action">РАЗРЕШИТЬ НАЛОЖЕНИЕ</string>
    <string name="onboarding_overlay_title">Наложение поверх окон</string>
    <string name="onboarding_overlay_granted">Разрешено</string>
    <string name="onboarding_overlay_pending">Не разрешено</string>
